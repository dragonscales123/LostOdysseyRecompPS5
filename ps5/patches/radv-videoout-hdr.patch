+static uint32_t
+videoout_format_count(void)
+{
+   videoout_settle_modes();
+   return videoout_output.hdr_offered ? ARRAY_SIZE(videoout_formats) : 2;
+}
+
+/* The VideoOut pixel format for a swapchain's format and colour space; 0 for
+ * one the surface does not offer. */
+static uint64_t
+videoout_pixel_format(VkFormat format, VkColorSpaceKHR color_space)
+{
+   if (color_space == VK_COLOR_SPACE_SRGB_NONLINEAR_KHR &&
+       (format == VK_FORMAT_B8G8R8A8_UNORM || format == VK_FORMAT_B8G8R8A8_SRGB))
+      return PS5_VIDEO_OUT_PIXEL_FORMAT_B8G8R8A8_SDR;
+   if (color_space == VK_COLOR_SPACE_HDR10_ST2084_EXT && videoout_output.hdr_offered) {
+      if (format == VK_FORMAT_A2B10G10R10_UNORM_PACK32)
+         return PS5_VIDEO_OUT_PIXEL_FORMAT_A2B10G10R10_PQ;
+      if (format == VK_FORMAT_A2R10G10B10_UNORM_PACK32)
+         return PS5_VIDEO_OUT_PIXEL_FORMAT_A2R10G10B10_PQ;
+   }
+   return 0;
+}
