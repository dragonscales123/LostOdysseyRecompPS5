+ * of byte 8 says HDR output is available (AnyPS5 PR #5697, after
+ * SharpProspero; a console in HDR read 02 00 00 00 02 00 00 00 03). */
+#define PS5_VIDEO_OUT_DYNAMIC_RANGE_HDR 2
+#define PS5_VIDEO_OUT_STATUS_FLAG_HDR 0x1
