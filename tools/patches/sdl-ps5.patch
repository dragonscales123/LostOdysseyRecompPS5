+#ifdef SDL_VIDEO_DRIVER_PS5
+
+/* PlayStation 5 video: one display, fullscreen windows, Vulkan only. The
+ * Vulkan driver is RADV linked into the title (PS5_Vulkan); it presents with
+ * VK_KHR_display on the console's one display, so a window's surface is a
+ * display-plane surface (SDL_Vulkan_Display_CreateSurface). The display's
+ * resolution is read once from that driver at VideoInit. */
+
+#include "../SDL_sysvideo.h"
+#include "../SDL_vulkan_internal.h"
+#include "../../events/SDL_keyboard_c.h"
+#include "../../events/SDL_mouse_c.h"
+#include "../../events/SDL_windowevents_c.h"
+#include "../../core/ps5/SDL_ps5.h"
+
+#define PS5_DEFAULT_WIDTH 3840
+#define PS5_DEFAULT_HEIGHT 2160
+#define PS5_DEFAULT_REFRESH 60.0f
+
+static SDL_Window *ps5_window; // the console has one display and one window
+
+// The display's physical resolution and best refresh rate, as the driver
+// reports them through VK_KHR_display. False when it cannot say.
+static bool PS5_QueryDisplay(int *w, int *h, float *refresh)
+{
+    PFN_vkGetInstanceProcAddr gipa = (PFN_vkGetInstanceProcAddr)SDL_PS5_GetVkGetInstanceProcAddr();
+    PFN_vkCreateInstance createInstance = (PFN_vkCreateInstance)gipa(VK_NULL_HANDLE, "vkCreateInstance");
+    if (!createInstance) {
+        return false;
+    }
+    static const char *const extensions[] = { VK_KHR_SURFACE_EXTENSION_NAME, VK_KHR_DISPLAY_EXTENSION_NAME };
+    VkApplicationInfo app = { VK_STRUCTURE_TYPE_APPLICATION_INFO };
+    app.pApplicationName = "SDL";
+    app.apiVersion = VK_API_VERSION_1_1;
+    VkInstanceCreateInfo info = { VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO };
+    info.pApplicationInfo = &app;
+    info.enabledExtensionCount = SDL_arraysize(extensions);
+    info.ppEnabledExtensionNames = extensions;
+    VkInstance instance = VK_NULL_HANDLE;
+    if (createInstance(&info, NULL, &instance) != VK_SUCCESS) {
+        return false;
+    }
+#define PS5_VK(name) PFN_##name name = (PFN_##name)gipa(instance, #name)
+    PS5_VK(vkDestroyInstance);
+    PS5_VK(vkEnumeratePhysicalDevices);
+    PS5_VK(vkGetPhysicalDeviceDisplayPropertiesKHR);
+    PS5_VK(vkGetDisplayModePropertiesKHR);
+#undef PS5_VK
+    bool found = false;
+    VkPhysicalDevice gpu = VK_NULL_HANDLE;
+    uint32_t count = 1;
+    if (vkEnumeratePhysicalDevices && vkGetPhysicalDeviceDisplayPropertiesKHR && vkGetDisplayModePropertiesKHR &&
+        vkEnumeratePhysicalDevices(instance, &count, &gpu) >= VK_SUCCESS && count > 0) {
+        VkDisplayPropertiesKHR display;
+        count = 1;
+        if (vkGetPhysicalDeviceDisplayPropertiesKHR(gpu, &count, &display) >= VK_SUCCESS && count > 0) {
+            *w = (int)display.physicalResolution.width;
+            *h = (int)display.physicalResolution.height;
+            *refresh = PS5_DEFAULT_REFRESH;
+            uint32_t modes = 0;
+            if (vkGetDisplayModePropertiesKHR(gpu, display.display, &modes, NULL) == VK_SUCCESS && modes > 0) {
+                VkDisplayModePropertiesKHR *props = SDL_calloc(modes, sizeof(*props));
+                if (props && vkGetDisplayModePropertiesKHR(gpu, display.display, &modes, props) >= VK_SUCCESS) {
+                    uint32_t best = 0;
+                    for (uint32_t i = 0; i < modes; ++i) {
+                        if ((int)props[i].parameters.visibleRegion.width == *w &&
+                            (int)props[i].parameters.visibleRegion.height == *h &&
+                            props[i].parameters.refreshRate > best) {
+                            best = props[i].parameters.refreshRate;
+                        }
+                    }
+                    if (best) {
+                        *refresh = best / 1000.0f; // millihertz
+                    }
+                }
+                SDL_free(props);
+            }
+            found = *w > 0 && *h > 0;
+        }
+    }
+    if (vkDestroyInstance) {
+        vkDestroyInstance(instance, NULL);
+    }
+    return found;
+}
+
+static bool PS5_VideoInit(SDL_VideoDevice *_this)
+{
+    int w = PS5_DEFAULT_WIDTH, h = PS5_DEFAULT_HEIGHT;
+    float refresh = PS5_DEFAULT_REFRESH;
+    if (!PS5_QueryDisplay(&w, &h, &refresh)) {
+        w = PS5_DEFAULT_WIDTH;
+        h = PS5_DEFAULT_HEIGHT;
+        refresh = PS5_DEFAULT_REFRESH;
+    }
+    SDL_DisplayMode mode;
+    SDL_zero(mode);
+    mode.format = SDL_PIXELFORMAT_ARGB8888;
+    mode.w = w;
+    mode.h = h;
+    mode.refresh_rate = refresh;
+
+    SDL_VideoDisplay display;
+    SDL_zero(display);
+    display.name = "PlayStation 5";
+    display.desktop_mode = mode;
+    if (SDL_AddVideoDisplay(&display, false) == 0) {
+        return false;
+    }
+    // No keyboard or mouse: the controller is the input.
+    return true;
+}
+
+static void PS5_VideoQuit(SDL_VideoDevice *_this)
+{
+    ps5_window = NULL;
+}
+
+static bool PS5_CreateWindow(SDL_VideoDevice *_this, SDL_Window *window, SDL_PropertiesID create_props)
+{
+    if (ps5_window) {
+        return SDL_SetError("Only one window is supported on PS5");
+    }
+    const SDL_DisplayMode *mode = SDL_GetDesktopDisplayMode(SDL_GetPrimaryDisplay());
+    if (mode) {
+        window->x = 0;
+        window->y = 0;
+        window->w = window->pending.w = window->windowed.w = mode->w;
+        window->h = window->pending.h = window->windowed.h = mode->h;
+    }
+    window->flags |= SDL_WINDOW_FULLSCREEN | SDL_WINDOW_BORDERLESS;
+    window->flags &= ~SDL_WINDOW_RESIZABLE;
+    ps5_window = window;
+    SDL_SetKeyboardFocus(window);
+    return true;
+}
+
+static void PS5_DestroyWindow(SDL_VideoDevice *_this, SDL_Window *window)
+{
+    if (window == ps5_window) {
+        ps5_window = NULL;
+    }
+}
+
+static void PS5_SetWindowTitle(SDL_VideoDevice *_this, SDL_Window *window)
+{
+}
+
+static bool PS5_SetWindowPosition(SDL_VideoDevice *_this, SDL_Window *window)
+{
+    return SDL_Unsupported();
+}
+
+static void PS5_SetWindowSize(SDL_VideoDevice *_this, SDL_Window *window)
+{
+    // The window is the display; report its size back.
+    const SDL_DisplayMode *mode = SDL_GetDesktopDisplayMode(SDL_GetPrimaryDisplay());
+    if (mode) {
+        SDL_SendWindowEvent(window, SDL_EVENT_WINDOW_RESIZED, mode->w, mode->h);
+    }
+}
+
+static void PS5_ShowWindow(SDL_VideoDevice *_this, SDL_Window *window)
+{
+    SDL_SetKeyboardFocus(window);
+}
+
+static void PS5_HideWindow(SDL_VideoDevice *_this, SDL_Window *window)
+{
+}
+
+static SDL_FullscreenResult PS5_SetWindowFullscreen(SDL_VideoDevice *_this, SDL_Window *window,
+                                                    SDL_VideoDisplay *display, SDL_FullscreenOp fullscreen)
+{
+    // Always fullscreen.
+    return SDL_FULLSCREEN_SUCCEEDED;
+}
+
+static void PS5_PumpEvents(SDL_VideoDevice *_this)
+{
+    // Controllers are read by the joystick subsystem; there is nothing else.
+}
+
+#ifdef SDL_VIDEO_VULKAN
+static bool PS5_Vulkan_LoadLibrary(SDL_VideoDevice *_this, const char *path)
+{
+    if (_this->vulkan_config.vkGetInstanceProcAddr) {
+        return true;
+    }
+    PFN_vkGetInstanceProcAddr gipa = (PFN_vkGetInstanceProcAddr)SDL_PS5_GetVkGetInstanceProcAddr();
+    _this->vulkan_config.vkGetInstanceProcAddr = (void *)gipa;
+    _this->vulkan_config.vkEnumerateInstanceExtensionProperties =
+        (void *)gipa(VK_NULL_HANDLE, "vkEnumerateInstanceExtensionProperties");
+    SDL_strlcpy(_this->vulkan_config.loader_path, "radv (linked)", SDL_arraysize(_this->vulkan_config.loader_path));
+    if (!_this->vulkan_config.vkEnumerateInstanceExtensionProperties) {
+        _this->vulkan_config.vkGetInstanceProcAddr = NULL;
+        return SDL_SetError("The linked Vulkan driver does not answer");
+    }
+    return true;
+}
+
+static void PS5_Vulkan_UnloadLibrary(SDL_VideoDevice *_this)
+{
+    // Linked into the title: nothing to unload.
+}
+
+static char const *const *PS5_Vulkan_GetInstanceExtensions(SDL_VideoDevice *_this, Uint32 *count)
+{
+    static const char *const extensions[] = { VK_KHR_SURFACE_EXTENSION_NAME, VK_KHR_DISPLAY_EXTENSION_NAME };
+    if (count) {
+        *count = SDL_arraysize(extensions);
+    }
+    return extensions;
+}
+
+static bool PS5_Vulkan_CreateSurface(SDL_VideoDevice *_this, SDL_Window *window, VkInstance instance,
+                                     const struct VkAllocationCallbacks *allocator, VkSurfaceKHR *surface)
+{
+    if (!_this->vulkan_config.vkGetInstanceProcAddr) {
+        return SDL_SetError("Vulkan is not loaded");
+    }
+    return SDL_Vulkan_Display_CreateSurface(_this->vulkan_config.vkGetInstanceProcAddr, instance, allocator, surface);
+}
+
+static void PS5_Vulkan_DestroySurface(SDL_VideoDevice *_this, VkInstance instance, VkSurfaceKHR surface,
+                                      const struct VkAllocationCallbacks *allocator)
+{
+    if (_this->vulkan_config.vkGetInstanceProcAddr) {
+        SDL_Vulkan_DestroySurface_Internal(_this->vulkan_config.vkGetInstanceProcAddr, instance, surface, allocator);
+    }
+}
+#endif // SDL_VIDEO_VULKAN
+
+static void PS5_DeleteDevice(SDL_VideoDevice *device)
+{
+    SDL_free(device);
+}
+
+static SDL_VideoDevice *PS5_CreateDevice(void)
+{
+    SDL_VideoDevice *device = (SDL_VideoDevice *)SDL_calloc(1, sizeof(SDL_VideoDevice));
+    if (!device) {
+        return NULL;
+    }
+    device->free = PS5_DeleteDevice;
+    device->VideoInit = PS5_VideoInit;
+    device->VideoQuit = PS5_VideoQuit;
+    device->CreateSDLWindow = PS5_CreateWindow;
+    device->DestroyWindow = PS5_DestroyWindow;
+    device->SetWindowTitle = PS5_SetWindowTitle;
+    device->SetWindowPosition = PS5_SetWindowPosition;
+    device->SetWindowSize = PS5_SetWindowSize;
+    device->ShowWindow = PS5_ShowWindow;
+    device->HideWindow = PS5_HideWindow;
+    device->SetWindowFullscreen = PS5_SetWindowFullscreen;
+    device->PumpEvents = PS5_PumpEvents;
+#ifdef SDL_VIDEO_VULKAN
+    device->Vulkan_LoadLibrary = PS5_Vulkan_LoadLibrary;
+    device->Vulkan_UnloadLibrary = PS5_Vulkan_UnloadLibrary;
+    device->Vulkan_GetInstanceExtensions = PS5_Vulkan_GetInstanceExtensions;
+    device->Vulkan_CreateSurface = PS5_Vulkan_CreateSurface;
+    device->Vulkan_DestroySurface = PS5_Vulkan_DestroySurface;
+#endif
+    device->device_caps = VIDEO_DEVICE_CAPS_FULLSCREEN_ONLY;
+    return device;
+}
+
+VideoBootStrap PS5_bootstrap = {
+    "ps5", "PlayStation 5 video (Vulkan, VK_KHR_display)", PS5_CreateDevice, NULL, false
+};
+
+#endif // SDL_VIDEO_DRIVER_PS5
