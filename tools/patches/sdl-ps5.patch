+     in a product, an acknowledgment in the product documentation would be
+     appreciated but is not required.
+  2. Altered source versions must be plainly marked as such, and must not be
+     misrepresented as being the original software.
+  3. This notice may not be removed or altered from any source distribution.
+*/
+#include "SDL_internal.h"
+
+#ifdef SDL_JOYSTICK_PS5
+
+/* PlayStation 5 controllers through scePad. The console pairs each controller
+ * with a signed-in user and scePadOpen opens a user's, so a joystick here is a
+ * signed-in user's controller: the user who started the title first, then any
+ * user who signs in later (scanned about once a second), up to four. The
+ * buttons and axes follow SDL's standard gamepad order, so the driver supplies
+ * its own gamepad mapping. The GUID carries Sony's DualSense vendor and product
+ * (SDL_GetGamepadType reports PS5, so games show PlayStation glyphs) with a
+ * driver signature no mapping database entry uses. */
+
+#include "../SDL_sysjoystick.h"
+#include "../SDL_joystick_c.h"
+#include "../../core/ps5/SDL_ps5.h"
+
+#define PS5_PAD_SLOTS 4
+#define PS5_PAD_SCAN_NS SDL_NS_PER_SECOND
+#define PS5_PAD_SIGNATURE 'P'
+#define PS5_PAD_VENDOR 0x054c  // Sony
+#define PS5_PAD_PRODUCT 0x0ce6 // DualSense
+
+// Buttons in SDL_GamepadButton order (south, east, west, north, ...).
+static const Uint32 ps5_button_bits[] = {
+    SDL_PS5_PAD_CROSS,     // SDL_GAMEPAD_BUTTON_SOUTH
+    SDL_PS5_PAD_CIRCLE,    // SDL_GAMEPAD_BUTTON_EAST
+    SDL_PS5_PAD_SQUARE,    // SDL_GAMEPAD_BUTTON_WEST
+    SDL_PS5_PAD_TRIANGLE,  // SDL_GAMEPAD_BUTTON_NORTH
+    SDL_PS5_PAD_TOUCH_PAD, // SDL_GAMEPAD_BUTTON_BACK (the touch pad's click)
+    0,                     // SDL_GAMEPAD_BUTTON_GUIDE (the PS button belongs to the shell)
+    SDL_PS5_PAD_OPTIONS,   // SDL_GAMEPAD_BUTTON_START
+    SDL_PS5_PAD_L3,        // SDL_GAMEPAD_BUTTON_LEFT_STICK
+    SDL_PS5_PAD_R3,        // SDL_GAMEPAD_BUTTON_RIGHT_STICK
+    SDL_PS5_PAD_L1,        // SDL_GAMEPAD_BUTTON_LEFT_SHOULDER
+    SDL_PS5_PAD_R1,        // SDL_GAMEPAD_BUTTON_RIGHT_SHOULDER
+    SDL_PS5_PAD_UP,        // SDL_GAMEPAD_BUTTON_DPAD_UP
+    SDL_PS5_PAD_DOWN,      // SDL_GAMEPAD_BUTTON_DPAD_DOWN
+    SDL_PS5_PAD_LEFT,      // SDL_GAMEPAD_BUTTON_DPAD_LEFT
+    SDL_PS5_PAD_RIGHT,     // SDL_GAMEPAD_BUTTON_DPAD_RIGHT
+};
+#define PS5_PAD_BUTTONS ((int)SDL_arraysize(ps5_button_bits))
+// left x, left y, right x, right y, left trigger, right trigger
+#define PS5_PAD_AXES 6
+
+typedef struct PS5PadSlot
+{
+    int32_t user;
+    int32_t handle;
+    SDL_JoystickID instance_id; // 0 while no joystick has been announced
+    SDL_Joystick *joystick;     // while opened by the application
+    SDL_PS5PadSample last;
+    bool fresh; // opened, no axis reported yet: send them all once
+} PS5PadSlot;
+
+static PS5PadSlot ps5_slots[PS5_PAD_SLOTS];
+static bool ps5_pad_service;
+static Uint64 ps5_next_scan;
+
+static void PS5_SlotReset(PS5PadSlot *slot)
+{
+    SDL_zerop(slot);
+    slot->user = -1;
+    slot->handle = -1;
+    slot->last.left_x = slot->last.left_y = slot->last.right_x = slot->last.right_y = 128;
+}
+
+static bool PS5_SlotOpen(PS5PadSlot *slot, int32_t user, int attempts)
+{
+    int32_t handle = -1;
+    // A title can start before the pad service has published the device.
+    for (int attempt = 0; attempt < attempts && handle < 0; ++attempt) {
+        handle = scePadOpen(user, 0, 0, NULL);
+        if (handle < 0 && attempt + 1 < attempts) {
+            sceKernelUsleep(100000);
+        }
+    }
+    // A handle this process already holds for the user is reused.
+    if (handle < 0) {
+        handle = scePadGetHandle(user, 0, 0);
+    }
+    if (handle < 0) {
+        return false;
+    }
+    PS5_SlotReset(slot);
+    slot->user = user;
+    slot->handle = handle;
+    (void)scePadSetVibrationMode(handle, SDL_PS5_PAD_VIBRATION_COMPATIBLE);
+    slot->instance_id = SDL_GetNextObjectID();
+    SDL_PrivateJoystickAdded(slot->instance_id);
+    return true;
+}
+
+static void PS5_SlotClose(PS5PadSlot *slot)
+{
+    if (slot->handle < 0) {
+        return;
+    }
+    const SDL_JoystickID id = slot->instance_id;
+    (void)scePadClose(slot->handle);
+    PS5_SlotReset(slot);
+    if (id) {
+        SDL_PrivateJoystickRemoved(id);
+    }
+}
+
+// The signed-in users again: a user who signed out lets their controller go,
+// a new user's controller takes the first free slot.
+static void PS5_Scan(void)
+{
+    SDL_PS5UserList list = { { -1, -1, -1, -1 } };
+    if (sceUserServiceGetLoginUserIdList(&list) < 0) {
+        return;
+    }
+    for (int s = 0; s < PS5_PAD_SLOTS; ++s) {
+        if (ps5_slots[s].handle < 0) {
+            continue;
+        }
+        bool signed_in = false;
+        for (int i = 0; i < 4; ++i) {
+            signed_in |= list.user_id[i] >= 0 && list.user_id[i] == ps5_slots[s].user;
+        }
+        if (!signed_in) {
+            PS5_SlotClose(&ps5_slots[s]);
+        }
+    }
+    for (int i = 0; i < 4; ++i) {
+        const int32_t user = list.user_id[i];
+        bool known = user < 0;
+        for (int s = 0; s < PS5_PAD_SLOTS && !known; ++s) {
+            known = ps5_slots[s].handle >= 0 && ps5_slots[s].user == user;
+        }
+        for (int s = 0; s < PS5_PAD_SLOTS && !known; ++s) {
+            if (ps5_slots[s].handle < 0) {
+                (void)PS5_SlotOpen(&ps5_slots[s], user, 1);
+                break;
+            }
+        }
+    }
+}
+
+static PS5PadSlot *PS5_SlotForIndex(int device_index)
+{
+    for (int s = 0; s < PS5_PAD_SLOTS; ++s) {
+        if (ps5_slots[s].handle >= 0) {
+            if (device_index == 0) {
+                return &ps5_slots[s];
+            }
+            --device_index;
+        }
+    }
+    return NULL;
+}
+
+static bool PS5_JoystickInit(void)
+{
+    for (int s = 0; s < PS5_PAD_SLOTS; ++s) {
+        PS5_SlotReset(&ps5_slots[s]);
+    }
+    if (!SDL_PS5_InitUserService() || scePadInit() < 0) {
+        // No pad service: no joysticks, not an error for SDL_Init.
+        return true;
+    }
+    ps5_pad_service = true;
+    int32_t user = -1;
+    if (sceUserServiceGetInitialUser(&user) >= 0) {
+        (void)PS5_SlotOpen(&ps5_slots[0], user, 10);
+    }
+    PS5_Scan();
+    ps5_next_scan = SDL_GetTicksNS() + PS5_PAD_SCAN_NS;
+    return true;
+}
+
+static int PS5_JoystickGetCount(void)
+{
+    int count = 0;
+    for (int s = 0; s < PS5_PAD_SLOTS; ++s) {
+        count += ps5_slots[s].handle >= 0;
+    }
+    return count;
+}
+
+static void PS5_JoystickDetect(void)
+{
+    if (!ps5_pad_service) {
+        return;
+    }
+    const Uint64 now = SDL_GetTicksNS();
+    if (now >= ps5_next_scan) {
+        PS5_Scan();
+        ps5_next_scan = now + PS5_PAD_SCAN_NS;
+    }
+}
+
+static bool PS5_JoystickIsDevicePresent(Uint16 vendor_id, Uint16 product_id, Uint16 version, const char *name)
+{
+    return false;
+}
+
+static const char *PS5_JoystickGetDeviceName(int device_index)
+{
+    return "DualSense Wireless Controller";
+}
+
+static const char *PS5_JoystickGetDevicePath(int device_index)
+{
+    return NULL;
+}
+
+static int PS5_JoystickGetDeviceSteamVirtualGamepadSlot(int device_index)
+{
+    return -1;
+}
+
+static int PS5_JoystickGetDevicePlayerIndex(int device_index)
+{
+    const PS5PadSlot *slot = PS5_SlotForIndex(device_index);
+    return slot ? (int)(slot - ps5_slots) : -1;
+}
+
+static void PS5_JoystickSetDevicePlayerIndex(int device_index, int player_index)
+{
+}
+
+static SDL_GUID PS5_JoystickGetDeviceGUID(int device_index)
+{
+    return SDL_CreateJoystickGUID(SDL_HARDWARE_BUS_UNKNOWN, PS5_PAD_VENDOR, PS5_PAD_PRODUCT, 0,
+                                  NULL, PS5_JoystickGetDeviceName(device_index), PS5_PAD_SIGNATURE, 0);
+}
+
+static SDL_JoystickID PS5_JoystickGetDeviceInstanceID(int device_index)
+{
+    const PS5PadSlot *slot = PS5_SlotForIndex(device_index);
+    return slot ? slot->instance_id : 0;
+}
+
+static bool PS5_JoystickOpen(SDL_Joystick *joystick, int device_index)
+{
+    PS5PadSlot *slot = PS5_SlotForIndex(device_index);
+    if (!slot) {
+        return SDL_SetError("No such PS5 controller");
+    }
+    slot->joystick = joystick;
+    // SDL takes an axis' first report as its value and resting point, and an
+    // axis never reported stays 0: a trigger's 0 is half pressed.
+    slot->fresh = true;
+    joystick->hwdata = (struct joystick_hwdata *)slot;
+    joystick->nbuttons = PS5_PAD_BUTTONS;
+    joystick->naxes = PS5_PAD_AXES;
+    joystick->nhats = 0;
+    SDL_SetBooleanProperty(SDL_GetJoystickProperties(joystick), SDL_PROP_JOYSTICK_CAP_RGB_LED_BOOLEAN, true);
+    SDL_SetBooleanProperty(SDL_GetJoystickProperties(joystick), SDL_PROP_JOYSTICK_CAP_RUMBLE_BOOLEAN, true);
+    return true;
+}
+
+static bool PS5_JoystickRumble(SDL_Joystick *joystick, Uint16 low_frequency_rumble, Uint16 high_frequency_rumble)
+{
+    PS5PadSlot *slot = (PS5PadSlot *)joystick->hwdata;
+    if (!slot || slot->handle < 0) {
+        return SDL_Unsupported();
+    }
+    const Uint8 motors[2] = { (Uint8)(low_frequency_rumble >> 8), (Uint8)(high_frequency_rumble >> 8) };
+    return scePadSetVibration(slot->handle, motors) >= 0 ? true : SDL_SetError("scePadSetVibration failed");
+}
+
+static bool PS5_JoystickRumbleTriggers(SDL_Joystick *joystick, Uint16 left_rumble, Uint16 right_rumble)
+{
+    return SDL_Unsupported();
+}
+
+static bool PS5_JoystickSetLED(SDL_Joystick *joystick, Uint8 red, Uint8 green, Uint8 blue)
+{
+    PS5PadSlot *slot = (PS5PadSlot *)joystick->hwdata;
+    if (!slot || slot->handle < 0) {
+        return SDL_Unsupported();
+    }
+    const Uint8 color[4] = { red, green, blue, 0 };
+    return scePadSetLightBar(slot->handle, color) >= 0 ? true : SDL_SetError("scePadSetLightBar failed");
+}
+
+static bool PS5_JoystickSendEffect(SDL_Joystick *joystick, const void *data, int size)
+{
+    return SDL_Unsupported();
+}
+
+static bool PS5_JoystickSetSensorsEnabled(SDL_Joystick *joystick, bool enabled)
+{
+    return SDL_Unsupported();
+}
+
+static Sint16 PS5_Stick(Uint8 value)
+{
+    // 0..255 with 128 at rest, to SDL's -32768..32767.
+    const int v = ((int)value - 128) * 256;
+    return (Sint16)(v > SDL_JOYSTICK_AXIS_MAX ? SDL_JOYSTICK_AXIS_MAX : v);
+}
+
+static Sint16 PS5_Trigger(Uint8 value)
+{
+    // 0..255 to the full axis range, released at -32768: the mapping's
+    // "lefttrigger:a4" is a full-range axis, which SDL's gamepad layer scales
+    // to 0..32767. Reporting 0 at rest read as a trigger held halfway.
+    return (Sint16)(((int)value * (SDL_JOYSTICK_AXIS_MAX - SDL_JOYSTICK_AXIS_MIN)) / 255 + SDL_JOYSTICK_AXIS_MIN);
+}
+
+static void PS5_JoystickUpdate(SDL_Joystick *joystick)
+{
+    PS5PadSlot *slot = (PS5PadSlot *)joystick->hwdata;
+    if (!slot || slot->handle < 0) {
+        return;
+    }
+    static SDL_PS5PadSample samples[64];
+    const int count = scePadRead(slot->handle, samples, (int32_t)SDL_arraysize(samples));
+    for (int i = 0; i < count && i < (int)SDL_arraysize(samples); ++i) {
+        const SDL_PS5PadSample *sample = &samples[i];
+        if (!sample->connected) {
+            continue;
+        }
+        SDL_PS5PadSample now = *sample;
+        // While the shell has the pad, the title sees a controller at rest.
+        if (now.buttons & SDL_PS5_PAD_INTERCEPTED) {
+            SDL_zero(now);
+            now.left_x = now.left_y = now.right_x = now.right_y = 128;
+        }
+        const Uint64 timestamp = SDL_US_TO_NS(sample->timestamp_us);
+        for (int b = 0; b < PS5_PAD_BUTTONS; ++b) {
+            const Uint32 bit = ps5_button_bits[b];
+            if (bit && ((now.buttons ^ slot->last.buttons) & bit)) {
+                SDL_SendJoystickButton(timestamp, joystick, (Uint8)b, (now.buttons & bit) != 0);
+            }
+        }
+        if (slot->fresh || now.left_x != slot->last.left_x) {
+            SDL_SendJoystickAxis(timestamp, joystick, 0, PS5_Stick(now.left_x));
+        }
+        if (slot->fresh || now.left_y != slot->last.left_y) {
+            SDL_SendJoystickAxis(timestamp, joystick, 1, PS5_Stick(now.left_y));
+        }
+        if (slot->fresh || now.right_x != slot->last.right_x) {
+            SDL_SendJoystickAxis(timestamp, joystick, 2, PS5_Stick(now.right_x));
+        }
+        if (slot->fresh || now.right_y != slot->last.right_y) {
+            SDL_SendJoystickAxis(timestamp, joystick, 3, PS5_Stick(now.right_y));
+        }
+        if (slot->fresh || now.l2 != slot->last.l2) {
+            SDL_SendJoystickAxis(timestamp, joystick, 4, PS5_Trigger(now.l2));
+        }
+        if (slot->fresh || now.r2 != slot->last.r2) {
+            SDL_SendJoystickAxis(timestamp, joystick, 5, PS5_Trigger(now.r2));
+        }
+        slot->last = now;
+        slot->fresh = false;
+    }
+}
+
+static void PS5_JoystickClose(SDL_Joystick *joystick)
+{
+    PS5PadSlot *slot = (PS5PadSlot *)joystick->hwdata;
+    if (slot) {
+        slot->joystick = NULL;
+    }
+    joystick->hwdata = NULL;
+}
+
+static void PS5_JoystickQuit(void)
+{
+    for (int s = 0; s < PS5_PAD_SLOTS; ++s) {
+        if (ps5_slots[s].handle >= 0) {
+            (void)scePadClose(ps5_slots[s].handle);
+        }
+        PS5_SlotReset(&ps5_slots[s]);
+    }
+    ps5_pad_service = false;
+}
+
+static bool PS5_JoystickGetGamepadMapping(int device_index, SDL_GamepadMapping *out)
+{
+    if (!PS5_SlotForIndex(device_index)) {
+        return false;
+    }
+    SDL_InputMapping *buttons[] = {
+        &out->a, &out->b, &out->x, &out->y, &out->back, NULL, &out->start,
+        &out->leftstick, &out->rightstick, &out->leftshoulder, &out->rightshoulder,
+        &out->dpup, &out->dpdown, &out->dpleft, &out->dpright
+    };
+    SDL_COMPILE_TIME_ASSERT(ps5_buttons, SDL_arraysize(buttons) == SDL_arraysize(ps5_button_bits));
+    for (int b = 0; b < (int)SDL_arraysize(buttons); ++b) {
+        if (buttons[b]) {
+            buttons[b]->kind = EMappingKind_Button;
+            buttons[b]->target = (Uint8)b;
+        }
+    }
+    SDL_InputMapping *axes[PS5_PAD_AXES] = {
+        &out->leftx, &out->lefty, &out->rightx, &out->righty, &out->lefttrigger, &out->righttrigger
+    };
+    for (int a = 0; a < PS5_PAD_AXES; ++a) {
+        axes[a]->kind = EMappingKind_Axis;
+        axes[a]->target = (Uint8)a;
+    }
+    return true;
+}
+
+SDL_JoystickDriver SDL_PS5_JoystickDriver = {
+    PS5_JoystickInit,
+    PS5_JoystickGetCount,
+    PS5_JoystickDetect,
+    PS5_JoystickIsDevicePresent,
+    PS5_JoystickGetDeviceName,
+    PS5_JoystickGetDevicePath,
+    PS5_JoystickGetDeviceSteamVirtualGamepadSlot,
+    PS5_JoystickGetDevicePlayerIndex,
+    PS5_JoystickSetDevicePlayerIndex,
+    PS5_JoystickGetDeviceGUID,
+    PS5_JoystickGetDeviceInstanceID,
+    PS5_JoystickOpen,
+    PS5_JoystickRumble,
+    PS5_JoystickRumbleTriggers,
+    PS5_JoystickSetLED,
+    PS5_JoystickSendEffect,
+    PS5_JoystickSetSensorsEnabled,
+    PS5_JoystickUpdate,
+    PS5_JoystickClose,
+    PS5_JoystickQuit,
+    PS5_JoystickGetGamepadMapping
+};
+
+#endif // SDL_JOYSTICK_PS5
