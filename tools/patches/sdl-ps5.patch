+  2. Altered source versions must be plainly marked as such, and must not be
+     misrepresented as being the original software.
+  3. This notice may not be removed or altered from any source distribution.
+*/
+
+/* PlayStation 5 homebrew (a title built with the PS5 payload SDK, whose
+ * libraries name the console's exports but whose headers declare few of them).
+ * The declarations and the layouts below are the ones the console-tested PS5
+ * homebrew projects use (PS5_VulkanTemplate's ps5/src/platform.c, PS5_vkQuake's
+ * input and audio): no Sony header or code is involved. */
+
+#ifndef SDL_ps5_h_
+#define SDL_ps5_h_
+
+#include "SDL_internal.h"
+
+#ifdef SDL_PLATFORM_PS5
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// User service: each controller belongs to a signed-in user.
+typedef struct SDL_PS5UserList
+{
+    int32_t user_id[4];
+} SDL_PS5UserList;
+
+int sceUserServiceInitialize(const void *params);
+int sceUserServiceGetInitialUser(int32_t *user_id);
+int sceUserServiceGetLoginUserIdList(SDL_PS5UserList *list);
+
+// Controllers.
+int scePadInit(void);
+int scePadOpen(int32_t user_id, int32_t port_type, int32_t index, const void *params);
+int scePadGetHandle(int32_t user_id, int32_t port_type, int32_t index);
+int scePadRead(int32_t handle, void *samples, int32_t capacity);
+int scePadClose(int32_t handle);
+int scePadSetVibrationMode(int32_t handle, int32_t mode);
+int scePadSetVibration(int32_t handle, const void *vibration);
+int scePadSetLightBar(int32_t handle, const void *color);
+
+// One sample as the console writes it: 120 bytes.
+typedef struct SDL_PS5PadSample
+{
+    uint32_t buttons;
+    uint8_t left_x, left_y, right_x, right_y, l2, r2;
+    uint8_t reserved[66];
+    int32_t connected;
+    uint64_t timestamp_us;
+    uint8_t extension[16];
+    uint8_t connected_count;
+    uint8_t remaining[15];
+} SDL_PS5PadSample;
+
+#define SDL_PS5_PAD_L3          0x00000002u
+#define SDL_PS5_PAD_R3          0x00000004u
+#define SDL_PS5_PAD_OPTIONS     0x00000008u
+#define SDL_PS5_PAD_UP          0x00000010u
+#define SDL_PS5_PAD_RIGHT       0x00000020u
+#define SDL_PS5_PAD_DOWN        0x00000040u
+#define SDL_PS5_PAD_LEFT        0x00000080u
+#define SDL_PS5_PAD_L2          0x00000100u
+#define SDL_PS5_PAD_R2          0x00000200u
+#define SDL_PS5_PAD_L1          0x00000400u
+#define SDL_PS5_PAD_R1          0x00000800u
+#define SDL_PS5_PAD_TRIANGLE    0x00001000u
+#define SDL_PS5_PAD_CIRCLE      0x00002000u
+#define SDL_PS5_PAD_CROSS       0x00004000u
+#define SDL_PS5_PAD_SQUARE      0x00008000u
+#define SDL_PS5_PAD_TOUCH_PAD   0x00100000u
+// Set while the shell has the pad (home screen, system dialogs).
+#define SDL_PS5_PAD_INTERCEPTED 0x80000000u
+
+// The two-motor rumble (the other mode is the DualSense's haptics).
+#define SDL_PS5_PAD_VIBRATION_COMPATIBLE 2
+
+// Audio: the system user's main output port.
+int sceAudioOutInit(void);
+int sceAudioOutOpen(int32_t user, int32_t type, int32_t index, uint32_t grain, uint32_t rate, uint32_t format);
+int sceAudioOutOutput(int32_t port, const void *samples);
+int sceAudioOutClose(int32_t port);
+
+#define SDL_PS5_AUDIO_ALREADY_INITIALISED ((int)0x8026000e)
+#define SDL_PS5_AUDIO_FORMAT_S16_STEREO 1
+
+int sceKernelUsleep(uint32_t microseconds);
+
+// Starts the user service once; true when it answered.
+extern bool SDL_PS5_InitUserService(void);
+
+// The Vulkan driver linked into the title (PS5_Vulkan's RADV): every Vulkan
+// command is resolved through its ICD entry point.
+extern void *SDL_PS5_GetVkGetInstanceProcAddr(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif // SDL_PLATFORM_PS5
+
+#endif // SDL_ps5_h_
