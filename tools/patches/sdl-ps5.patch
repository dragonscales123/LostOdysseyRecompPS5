+#include "SDL_internal.h"
+
+#ifdef SDL_FILESYSTEM_PS5
+
+/* PlayStation 5 homebrew paths: the title's folder is mounted read-only at
+ * /app0/; writable data goes under /data/ (the console's homebrew data area,
+ * kept across title updates and reinstalls). The console has no getcwd. */
+
+#include "../SDL_sysfilesystem.h"
+
+#include <errno.h>
+#include <sys/stat.h>
+
+char *SDL_SYS_GetBasePath(void)
+{
+    return SDL_strdup("/app0/");
+}
+
+char *SDL_SYS_GetExeName(void)
+{
+    return SDL_strdup("eboot.bin");
+}
+
+static bool PS5_MakeDirs(char *path)
+{
+    // Every component in turn; an existing one is fine.
+    for (char *p = path + 1; *p; ++p) {
+        if (*p == '/') {
+            *p = '\0';
+            const int rc = mkdir(path, 0777);
+            *p = '/';
+            if (rc != 0 && errno != EEXIST) {
+                struct stat st;
+                if (stat(path, &st) != 0) {
+                    return false;
+                }
+            }
+        }
+    }
+    return true;
+}
+
+char *SDL_SYS_GetPrefPath(const char *org, const char *app)
+{
+    const size_t len = SDL_strlen("/data/") + SDL_strlen(org) + SDL_strlen(app) + 3;
+    char *result = (char *)SDL_malloc(len);
+    if (!result) {
+        return NULL;
+    }
+    if (*org) {
+        SDL_snprintf(result, len, "/data/%s/%s/", org, app);
+    } else {
+        SDL_snprintf(result, len, "/data/%s/", app);
+    }
+    if (!PS5_MakeDirs(result)) {
+        SDL_SetError("Couldn't create directory '%s': %s", result, strerror(errno));
+        SDL_free(result);
+        return NULL;
+    }
+    return result;
+}
+
+char *SDL_SYS_GetUserFolder(SDL_Folder folder)
+{
+    switch (folder) {
+    case SDL_FOLDER_HOME:
+    case SDL_FOLDER_DOCUMENTS:
+    case SDL_FOLDER_SAVEDGAMES:
+        return SDL_strdup("/data/");
+    default:
+        SDL_Unsupported();
+        return NULL;
+    }
+}
+
+char *SDL_SYS_GetCurrentDirectory(void)
+{
+    return SDL_strdup("/app0/");
+}
+
+#endif // SDL_FILESYSTEM_PS5
