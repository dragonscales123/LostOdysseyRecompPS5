diff --git a/src/audio/ps5/SDL_ps5audio.c b/src/audio/ps5/SDL_ps5audio.c
new file mode 100644
index 0000000..d78600a
--- /dev/null
+++ b/src/audio/ps5/SDL_ps5audio.c
@@ -0,0 +1,144 @@
+/*
+  Simple DirectMedia Layer
+  Copyright (C) 1997-2025 Sam Lantinga <slouken@libsdl.org>
+
+  This software is provided 'as-is', without any express or implied
+  warranty.  In no event will the authors be held liable for any damages
+  arising from the use of this software.
+
+  Permission is granted to anyone to use this software for any purpose,
+  including commercial applications, and to alter it and redistribute it
+  freely, subject to the following restrictions:
+
+  1. The origin of this software must not be misrepresented; you must not
+     claim that you wrote the original software. If you use this software
+     in a product, an acknowledgment in the product documentation would be
+     appreciated but is not required.
+  2. Altered source versions must be plainly marked as such, and must not be
+     misrepresented as being the original software.
+  3. This notice may not be removed or altered from any source distribution.
+*/
+#include "SDL_internal.h"
+
+#ifdef SDL_AUDIO_DRIVER_PS5
+
+/* PlayStation 5 audio output through sceAudioOut: the system user's main
+ * port, 48 kHz, 16-bit stereo, 256-frame grains, the configuration the
+ * console-tested homebrew titles use. sceAudioOutOutput blocks until the port
+ * takes the grain, so it paces SDL's audio thread; SDL converts whatever the
+ * application's streams carry to this format. */
+
+#include "../SDL_sysaudio.h"
+#include "../../core/ps5/SDL_ps5.h"
+
+#define PS5AUDIO_GRAIN 256
+#define PS5AUDIO_RATE 48000
+#define PS5AUDIO_BUFFERS 2
+
+struct SDL_PrivateAudioData
+{
+    int32_t port;
+    Uint8 *rawbuf;
+    Uint8 *mixbufs[PS5AUDIO_BUFFERS];
+    int next_buffer;
+};
+
+static bool PS5AUDIO_OpenDevice(SDL_AudioDevice *device)
+{
+    if (device->recording) {
+        return SDL_SetError("Recording is not supported on PS5");
+    }
+    device->hidden = (struct SDL_PrivateAudioData *)SDL_calloc(1, sizeof(*device->hidden));
+    if (!device->hidden) {
+        return false;
+    }
+    device->hidden->port = -1;
+
+    const int init = sceAudioOutInit();
+    if (init < 0 && init != SDL_PS5_AUDIO_ALREADY_INITIALISED) {
+        return SDL_SetError("sceAudioOutInit failed: 0x%08x", (unsigned)init);
+    }
+
+    device->spec.format = SDL_AUDIO_S16LE;
+    device->spec.channels = 2;
+    device->spec.freq = PS5AUDIO_RATE;
+    device->sample_frames = PS5AUDIO_GRAIN;
+    SDL_UpdatedAudioDeviceFormat(device);
+
+    const int port = sceAudioOutOpen(0xff, 0, 0, PS5AUDIO_GRAIN, PS5AUDIO_RATE, SDL_PS5_AUDIO_FORMAT_S16_STEREO);
+    if (port < 0) {
+        return SDL_SetError("sceAudioOutOpen failed: 0x%08x", (unsigned)port);
+    }
+    device->hidden->port = port;
+
+    const int mixlen = device->buffer_size * PS5AUDIO_BUFFERS;
+    device->hidden->rawbuf = (Uint8 *)SDL_aligned_alloc(64, mixlen);
+    if (!device->hidden->rawbuf) {
+        return false;
+    }
+    SDL_memset(device->hidden->rawbuf, 0, mixlen);
+    for (int i = 0; i < PS5AUDIO_BUFFERS; ++i) {
+        device->hidden->mixbufs[i] = &device->hidden->rawbuf[i * device->buffer_size];
+    }
+    return true;
+}
+
+static bool PS5AUDIO_PlayDevice(SDL_AudioDevice *device, const Uint8 *buffer, int buffer_size)
+{
+    // Blocks for one grain.
+    if (sceAudioOutOutput(device->hidden->port, buffer) < 0) {
+        // An output that stops taking grains must not spin the audio thread.
+        SDL_Delay(5);
+    }
+    return true;
+}
+
+static bool PS5AUDIO_WaitDevice(SDL_AudioDevice *device)
+{
+    // PlayDevice already waits for the port.
+    return true;
+}
+
+static Uint8 *PS5AUDIO_GetDeviceBuf(SDL_AudioDevice *device, int *buffer_size)
+{
+    Uint8 *result = device->hidden->mixbufs[device->hidden->next_buffer];
+    device->hidden->next_buffer = (device->hidden->next_buffer + 1) % PS5AUDIO_BUFFERS;
+    return result;
+}
+
+static void PS5AUDIO_CloseDevice(SDL_AudioDevice *device)
+{
+    if (device->hidden) {
+        if (device->hidden->port >= 0) {
+            (void)sceAudioOutOutput(device->hidden->port, NULL); // drain the queued grain
+            (void)sceAudioOutClose(device->hidden->port);
+        }
+        SDL_aligned_free(device->hidden->rawbuf);
+        SDL_free(device->hidden);
+        device->hidden = NULL;
+    }
+}
+
+static void PS5AUDIO_ThreadInit(SDL_AudioDevice *device)
+{
+    SDL_SetCurrentThreadPriority(device->recording ? SDL_THREAD_PRIORITY_HIGH : SDL_THREAD_PRIORITY_TIME_CRITICAL);
+}
+
+static bool PS5AUDIO_Init(SDL_AudioDriverImpl *impl)
+{
+    impl->OpenDevice = PS5AUDIO_OpenDevice;
+    impl->PlayDevice = PS5AUDIO_PlayDevice;
+    impl->WaitDevice = PS5AUDIO_WaitDevice;
+    impl->GetDeviceBuf = PS5AUDIO_GetDeviceBuf;
+    impl->CloseDevice = PS5AUDIO_CloseDevice;
+    impl->ThreadInit = PS5AUDIO_ThreadInit;
+    impl->OnlyHasDefaultPlaybackDevice = true;
+    impl->HasRecordingSupport = false;
+    return true;
+}
+
+AudioBootStrap PS5AUDIO_bootstrap = {
+    "ps5", "PlayStation 5 audio output", PS5AUDIO_Init, false, false
+};
+
+#endif // SDL_AUDIO_DRIVER_PS5
