+#ifdef SDL_PLATFORM_PS5
+
+#include "SDL_ps5.h"
+
+static SDL_InitState user_service_init;
+static bool user_service_ok;
+
+bool SDL_PS5_InitUserService(void)
+{
+    if (SDL_ShouldInit(&user_service_init)) {
+        // Already initialised by the title is fine: the call then fails, and
+        // the user queries below still answer.
+        (void)sceUserServiceInitialize(NULL);
+        int32_t user = -1;
+        user_service_ok = sceUserServiceGetInitialUser(&user) >= 0;
+        SDL_SetInitialized(&user_service_init, true);
+    }
+    return user_service_ok;
+}
+
+#ifdef SDL_VIDEO_VULKAN
+// RADV, linked into the title by PS5_Vulkan's link recipe, exports the ICD
+// entry point; there is no loader to dlopen.
+extern void *vk_icdGetInstanceProcAddr(void *instance, const char *name);
+
+void *SDL_PS5_GetVkGetInstanceProcAddr(void)
+{
+    return (void *)vk_icdGetInstanceProcAddr;
+}
+#endif
+
+#endif // SDL_PLATFORM_PS5
